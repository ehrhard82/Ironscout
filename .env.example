# ===================== IronScout configuration =====================
# Copy to .env and fill in. Anything left blank falls back to a safe default
# (sample data, console-printed emails, billing disabled) so you can run it
# locally with nothing but a database.

# --- Where the site lives (used in emails and Stripe redirects) ---
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- Database: EITHER a connection string (Neon, Supabase, Render, Railway...) ---
DATABASE_URL=
# --- OR a local Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpasswordhere
DB_NAME=ironscout

# --- Stripe (subscriptions). See routes/billing.js for the 15-minute setup. ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=7

# --- Email (alerts, password resets). resend.com, free for 3,000/month. ---
RESEND_API_KEY=
MAIL_FROM=IronScout <alerts@yourdomain.com>

# --- Text messages (optional). twilio.com. Leave blank to offer email only. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- External scheduler key (needed on hosts that sleep, e.g. Render free tier).
#     Make up a long random string. Then point cron-job.org at
#     https://YOURDOMAIN/api/cron/ingest?key=THIS  (daily) and
#     https://YOURDOMAIN/api/cron/alerts?key=THIS  (every 15 min) ---
CRON_SECRET=

# --- Local demo only: fake listings when no source is configured. Never on a real server. ---
SAMPLE_DATA=false

# --- eBay Browse API (free: developer.ebay.com). Blank = sample data. ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_US

# --- Apify-hosted scrapers for GovDeals / IronPlanet / Ritchie Bros (~$1.50-3 per 1,000 listings) ---
APIFY_TOKEN=
APIFY_SOURCES=govdeals,ironplanet
# APIFY_SOURCES=govdeals,ironplanet,rbauction
APIFY_MAX_ITEMS=100            # listings per source per machine per fetch (deals are in the ending-soonest ones)
APIFY_MAX_SOLD_ITEMS=100       # completed sales per source per machine per sold-fetch
APIFY_DAILY_ITEMS=1500         # hard cap on listings fetched per 24h across everything (~$3-5/day at most)

# --- Craigslist (best-effort scraping; usually leave off) ---
CRAIGSLIST_LIVE=false
CRAIGSLIST_CITIES=dallas,houston,oklahomacity,midland

# --- What to track. The scheduler / cron ingest refreshes these. ---
TRACKED_PRODUCTS=semi truck,wheel loader,excavator,dozer,winch truck,frac pump,drilling rig,skid steer

# --- Pricing engine (lib/pricing.js). These are the SYSTEM thresholds for flagging a
#     deal at all; each user then sets their own stricter filters in Settings. ---
DEAL_THRESHOLD_PERCENT=5
MIN_DEAL_DOLLARS=2500
TRANSACTION_COST_PERCENT=3
BUYER_PREMIUM_PERCENT=12       # default buyer's premium; per-source: BUYER_PREMIUM_GOVDEALS=12.5 BUYER_PREMIUM_IRONPLANET=10 BUYER_PREMIUM_RBAUCTION=10
# Freight estimate ($ per loaded mile by weight class) used for "delivered to your yard"
FREIGHT_RATE_LIGHT=2.75
FREIGHT_RATE_TRUCK=2.00        # drives itself (driver + fuel)
FREIGHT_RATE_MEDIUM=4.25       # lowboy, legal or near-legal load
FREIGHT_RATE_OVERSIZE=6.00     # permits + pilot car class
FREIGHT_MIN=650
FREIGHT_PERMITS_OVERSIZE=1400
AUCTION_MAX_HOURS=72           # auctions ending later than this are not flagged as deals yet
AUCTION_FIRM_HOURS=24          # bids on auctions ending within this many hours count as real prices
YEAR_BAND=3
MIN_SAMPLE_SIZE=5
MIN_VALID_PRICE=500
SOLD_REFRESH_DAYS=30           # how often to pull completed sales per machine (Apify credit)
SOLD_WINDOW_DAYS=120           # sales older than this no longer count toward market value

# --- Broker commission tracking ---
BROKER_ID=broker_1
COMMISSION_PERCENTAGE=10

# --- Built-in scheduler (only used when running `npm run schedule` on an always-on server) ---
INGEST_CRON=0 6 * * *

# --- Misc ---
SESSION_DAYS=30
MAX_WATCHLISTS=25
